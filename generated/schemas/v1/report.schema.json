{
  "$id": "https://schemas.rampspec.dev/backend/v1/report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "evidenceManifestHash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "extensions": {
      "additionalProperties": true,
      "description": "Namespaced forward-compatible extension values.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9.-]*$"
      },
      "type": "object"
    },
    "findingIds": {
      "items": {
        "pattern": "^finding_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "generatedAt": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "type": "string"
    },
    "reportId": {
      "pattern": "^report_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "runId": {
      "pattern": "^run_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0",
      "description": "Version of this individual contract.",
      "type": "string"
    },
    "summary": {
      "additionalProperties": false,
      "properties": {
        "failed": {
          "minimum": 0,
          "type": "integer"
        },
        "passed": {
          "minimum": 0,
          "type": "integer"
        },
        "skipped": {
          "minimum": 0,
          "type": "integer"
        },
        "warnings": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "passed",
        "failed",
        "warnings",
        "skipped"
      ],
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "reportId",
    "runId",
    "generatedAt",
    "summary",
    "findingIds",
    "evidenceManifestHash"
  ],
  "title": "RampSpec Report",
  "type": "object"
}
