APP_ENV=staging
APP_NAME=api
APP_PORT=3000
DATABASE_URL=postgresql://<managed-user>:<managed-host>:5432/rampspec
TEMPORAL_ADDRESS=<temporal-staging-host>:7233
TEMPORAL_NAMESPACE=rampspec-staging
REDIS_URL=rediss://<managed-redis-host>:6379
OBJECT_STORAGE_ENDPOINT=https://<managed-object-storage>
OBJECT_STORAGE_BUCKET=rampspec-staging-artifacts
OIDC_ISSUER=https://<staging-issuer>
OIDC_CLIENT_ID=rampspec-staging
OIDC_CLIENT_SECRET_REF=vault://rampspec/staging/oidc-client-secret
KMS_PROVIDER=aws
KMS_KEY_ID=alias/rampspec-staging
RUNNER_MODE=remote
RUNNER_CONTROL_PLANE_URL=https://api.staging.rampspec.dev
STELLAR_NETWORK=testnet
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
EVIDENCE_BUCKET=rampspec-staging-evidence
OTEL_EXPORTER_OTLP_ENDPOINT=https://<otel-staging-endpoint>
CONTROL_PLANE_URL=https://api.staging.rampspec.dev
