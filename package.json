{
  "name": "@rampspec/backend-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "RampSpec backend services, runners, protocol checks, and shared packages.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "12.4.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/verify-build.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:migrate": "pnpm build && node scripts/migrate.mjs",
    "db:seed": "pnpm build && node scripts/seed.mjs",
    "generate": "pnpm build && node scripts/generate.mjs",
    "lint": "eslint .",
    "release:manifest": "node scripts/create-release-manifest.mjs",
    "test": "vitest run",
    "test:database": "vitest run packages/platform/src/database/migrations.integration.test.ts",
    "typecheck": "tsc --noEmit",
    "verify:generated": "node scripts/verify-generated.mjs",
    "verify:workspace": "node scripts/verify-workspace.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.4",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
